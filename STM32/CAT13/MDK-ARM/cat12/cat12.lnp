"cat12\stm32f4xx_hal_rcc_ex.o"
"cat12\stm32f4xx_hal_flash.o"
"cat12\stm32f4xx_hal_flash_ex.o"
"cat12\stm32f4xx_hal_flash_ramfunc.o"
"cat12\stm32f4xx_hal_gpio.o"
"cat12\stm32f4xx_hal_dma_ex.o"
"cat12\stm32f4xx_hal_dma.o"
"cat12\stm32f4xx_hal_pwr.o"
